# Copy this file to .env before changing local Docker Compose settings.
POSTGRES_DB=visionpark
POSTGRES_USER=visionpark
POSTGRES_PASSWORD=visionpark
POSTGRES_PORT=5433

BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
JWT_SECRET_KEY=development-only-change-this-jwt-secret
CORS_ORIGINS=http://localhost:5173
ALPR_PROVIDER=mock

# Demo accounts are created idempotently at backend startup.
AUTO_SEED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=change-me-operator

# Vite values are embedded into the frontend during image build.
VITE_API_BASE_URL=/
VITE_API_TIMEOUT_MS=15000
VITE_USE_MOCK_FIXTURES=false
VITE_PUBLIC_REGISTRATION_ENABLED=false

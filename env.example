# Copy this file to .env before changing local Docker Compose settings.
POSTGRES_DB=visionpark
POSTGRES_USER=visionpark
POSTGRES_PASSWORD=visionpark
POSTGRES_PORT=5433

BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
# Generate a unique key before starting Compose; the placeholder is rejected.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
ALPR_PROVIDER=real
ALPR_OCR_ENABLED=true
INSTALL_REAL_ALPR=true
INSTALL_OCR=true
PUBLIC_REGISTRATION_ENABLED=false

# Demo accounts are created idempotently at backend startup.
AUTO_SEED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Explicit disposable Phase 3 fixtures: python -m app.database.seed_demo
# Set a local password of at least 12 characters; never run automatically.
DEMO_SEED_PASSWORD=

# Vite values are embedded into the frontend during image build.
VITE_API_BASE_URL=/
VITE_API_TIMEOUT_MS=15000
VITE_PUBLIC_REGISTRATION_ENABLED=false

# Real model mounts and warmup (provision assets first).
COMPOSE_FILE=docker-compose.yml;deployment/compose.real.yml
COMPOSE_PATH_SEPARATOR=;

# Functional gate: dedicated acceptance building only. Keep real values untracked.
GATE_ENVIRONMENT=
GATE_COMMIT=
GATE_USERNAME=
GATE_PASSWORD=
GATE_IN_LANE_ID=
GATE_OUT_LANE_ID=
GATE_CUSTOMER_CLASS_ID=
GATE_PLATE=
# Disposable CI PostgreSQL only; generated automatically in GitHub Actions.
CI_TEST_DB_PASSWORD=

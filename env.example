# Copy this file to .env before changing local Docker Compose settings.
POSTGRES_DB=visionpark
POSTGRES_USER=visionpark
POSTGRES_PASSWORD=visionpark
POSTGRES_PORT=5433

BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
# Generate a unique key before starting Compose; the placeholder is rejected.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
ALPR_PROVIDER=real
ALPR_OCR_ENABLED=true
INSTALL_REAL_ALPR=true
INSTALL_OCR=true
PUBLIC_REGISTRATION_ENABLED=false

# Demo accounts are created idempotently at backend startup.
AUTO_SEED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Vite values are embedded into the frontend during image build.
VITE_API_BASE_URL=/
VITE_API_TIMEOUT_MS=15000
VITE_PUBLIC_REGISTRATION_ENABLED=false

# Real model mounts and warmup (provision assets first).
COMPOSE_FILE=docker-compose.yml;deployment/compose.real.yml
COMPOSE_PATH_SEPARATOR=;

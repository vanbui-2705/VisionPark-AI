APP_NAME=VisionPark API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://visionpark:visionpark@localhost:5433/visionpark
DATABASE_ECHO=false

# Generate a unique value with at least 32 characters. Never commit the real secret.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173
UPLOAD_MAX_BYTES=5242880
LOCAL_STORAGE_PATH=./var/media
ALPR_PROVIDER=real
ALPR_MANIFEST_PATH=models/alpr-manifest.json
ALPR_DEVICE=cpu
ALPR_DETECTOR_CONFIDENCE=0.25
ALPR_CONFIDENCE_THRESHOLD=0.85
ALPR_OCR_MARGIN=0.08
ALPR_OCR_ENABLED=true
PUBLIC_REGISTRATION_ENABLED=false

# Local demo bootstrap. Keep false in production.
AUTO_SEED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
